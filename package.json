{
  "name": "iffe-sacco",
  "version": "1.0.0",
  "private": true,
  "description": "IFFE SACCO - Modern cooperative financial management platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter @iffe/api dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter web build",
    "build:api": "bun run --filter @iffe/api build",
    "lint": "bun run --filter '*' lint",
    "test": "bun run test:web && bun run test:api",
    "test:web": "bun run --filter web test",
    "test:api": "bun run --filter @iffe/api test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter @iffe/api db:generate",
    "db:migrate": "bun run --filter @iffe/api db:migrate",
    "db:push": "bun run --filter @iffe/api db:push",
    "db:studio": "bun run --filter @iffe/api db:studio",
    "db:seed": "bun run --filter @iffe/api db:seed",
    "db:seed:sql": "cd apps/api && bunx prisma db execute --stdin < prisma/seed.sql",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/web/.next apps/api/dist",
    "clean:build": "rm -rf apps/web/.next apps/api/dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=23.2.0",
    "bun": ">=1.3"
  },
  "overrides": {
    "typescript-eslint": "8.74.0"
  }
}
